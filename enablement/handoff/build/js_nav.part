/* nav */
let cur=0,frame=null,t0=0;const ST=parseFloat(new URLSearchParams(location.search).get('t'));if(ST>=0)document.body.classList.add('static');
function go(i){i=Math.max(0,Math.min(slides.length-1,i));slides[cur].classList.remove('on');cur=i;const s=slides[i];
  s.querySelectorAll('canvas.fx').forEach(c=>c.remove());s.querySelectorAll('.lat').forEach(e=>e.classList.remove('on'));
  s.classList.remove('on');void s.offsetWidth;s.classList.add('on');
  const f=FX[s.dataset.fx];frame=f?f(s):null;t0=performance.now()-(ST>=0?ST*1000:0);if(ST>=0&&frame)for(let k=0;k<ST;k+=1/30)frame(k);
  $('notes').innerHTML=`<b>Slide ${i+1} of ${slides.length}</b>${s.dataset.notes||''}`;
  const hd=$('hud');hd.textContent=`${i+1} / ${slides.length}  ·  N notes  ·  R replay  ·  F fullscreen  ·  G slides`;hd.style.opacity=1;clearTimeout(go.h);go.h=setTimeout(()=>hd.style.opacity=0,2500);
  history.replaceState(null,'',location.search+'#'+(i+1));}
(function loop(now){requestAnimationFrame(loop);if(!frame)return;try{frame((now-t0)/1000);}catch(err){console.error('slide animation error',err);frame=null;}})(performance.now());
// Coming back to the deck (for example from the live demo in another window) replays the current slide
// instead of showing an animation that finished while the window was hidden.
let hiddenAt=0;document.addEventListener('visibilitychange',()=>{if(document.hidden)hiddenAt=performance.now();else if(performance.now()-hiddenAt>300)go(cur);});
addEventListener('focus',()=>{if(hiddenAt&&performance.now()-hiddenAt>300){hiddenAt=0;go(cur);}});
addEventListener('blur',()=>{hiddenAt=performance.now();});
addEventListener('keydown',e=>{if(SR.open||e.metaKey||e.ctrlKey||e.altKey)return;if(e.key==='g'||e.key==='G'){e.stopImmediatePropagation();SR.show();return;}if(['ArrowRight','ArrowDown','PageDown',' ','Enter'].includes(e.key)){e.preventDefault();go(cur+1);}
  else if(['ArrowLeft','ArrowUp','PageUp','Backspace'].includes(e.key)){e.preventDefault();go(cur-1);}
  else if(e.key==='Home')go(0);else if(e.key==='End')go(slides.length-1);
  else if(e.key==='n'||e.key==='N'){const n=$('notes');n.style.display=n.style.display==='block'?'none':'block';}
  else if(e.key==='f'||e.key==='F'){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen();}
  else if(e.key==='r'||e.key==='R')go(cur);});
addEventListener('click',e=>{if(SR.open||e.target.closest('#notes')||e.target.closest('#sorter'))return;go(cur+(e.clientX<innerWidth/4?-1:1));});
function fit(){const s=Math.min(innerWidth/1280,innerHeight/720);deck.style.transform=`scale(${s})`;deck.style.left=(innerWidth-1280*s)/2+'px';deck.style.top=(innerHeight-720*s)/2+'px';}
addEventListener('resize',fit);fit();const TGT=(parseInt(location.hash.slice(1))||1)-1;
/* slide sorter: order and hidden slides persist per deck in this browser; Download writes a reordered copy */
const SR=(()=>{const ALL=slides.slice(),by={},fx=x=>x.dataset.fx;ALL.forEach(x=>by[fx(x)]=x);
  const KEY='deck-order:'+location.pathname.split('/').pop().replace(/-(bundle|share)(?=\.html$)/,'');
  const dflt=()=>({order:ALL.map(fx),hidden:ALL.filter(x=>x.dataset.hidden==='1').map(fx)});
  let st;try{st=JSON.parse(localStorage.getItem(KEY))||dflt();}catch(e){st=dflt();}
  const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}};
  function arrange(){const ord=st.order.filter(k=>by[k]);
    ALL.forEach((x,i)=>{const k=fx(x);if(ord.includes(k))return;const prev=i?fx(ALL[i-1]):null;ord.splice(prev?ord.indexOf(prev)+1:0,0,k);});
    st.order=ord;st.hidden=st.hidden.filter(k=>by[k]);if(st.hidden.length>=ord.length)st.hidden=[];
    ord.forEach(k=>deck.appendChild(by[k]));slides.splice(0,slides.length,...ord.filter(k=>!st.hidden.includes(k)).map(k=>by[k]));}
  arrange();
  const el$=$('sorter'),grid=$('srGrid'),thumbs={};let curEl=null,dragK=null;
  function thumb(k){if(thumbs[k])return thumbs[k];const x=by[k];
    x.querySelectorAll('canvas.fx').forEach(c=>c.remove());x.querySelectorAll('.lat').forEach(e=>e.classList.remove('on'));
    try{const f=FX[x.dataset.fx],fr=f?f(x):null;if(fr)for(let t=0;t<12;t+=1/10)fr(t);}catch(e){}
    const c=x.cloneNode(true);c.classList.add('on');c.querySelectorAll('[id]').forEach(e=>e.removeAttribute('id'));c.removeAttribute('id');
    const src=x.querySelectorAll('canvas'),dst=c.querySelectorAll('canvas');src.forEach((cv,i)=>{try{dst[i].getContext('2d').drawImage(cv,0,0);}catch(e){}});
    return thumbs[k]=c;}
  function render(){grid.innerHTML='';let n=0;
    st.order.forEach(k=>{const x=by[k],hid=st.hidden.includes(k);if(!hid)n++;
      const d=document.createElement('div');d.className='srC'+(hid?' srH':'')+(x===curEl?' srK':'');d.draggable=true;d.dataset.k=k;
      const h=x.querySelector('h1'),hc=h&&h.cloneNode(true);if(hc)hc.querySelectorAll('br').forEach(b=>b.replaceWith(' '));const title=(hc?hc.textContent:x.dataset.foot||k).replace(/\s+/g,' ').trim();
      d.innerHTML=`<div class="srT"></div><div class="srM"><span class="srN">${hid?'–':n}</span><span class="srX"></span></div><div class="srB"><button data-a="l" title="Move earlier">◀</button><button data-a="r" title="Move later">▶</button><button data-a="h">${hid?'Show':'Hide'}</button></div>`;
      d.querySelector('.srX').textContent=title;d.querySelector('.srT').appendChild(thumb(k));grid.appendChild(d);});}
  function commit(){arrange();save();render();}
  function move(k,to){const o=st.order,i=o.indexOf(k);o.splice(i,1);o.splice(Math.max(0,Math.min(o.length,to)),0,k);commit();}
  grid.addEventListener('click',e=>{const d=e.target.closest('.srC');if(!d)return;const k=d.dataset.k,b=e.target.closest('button');
    if(b){const a=b.dataset.a,i=st.order.indexOf(k);if(a==='l')move(k,i-1);else if(a==='r')move(k,i+1);
      else{const h=st.hidden;if(h.includes(k))h.splice(h.indexOf(k),1);else if(h.length<st.order.length-1)h.push(k);commit();}return;}
    if(st.hidden.includes(k))return;close(slides.indexOf(by[k]));});
  grid.addEventListener('dragstart',e=>{const d=e.target.closest('.srC');if(!d)return;dragK=d.dataset.k;d.classList.add('srD');e.dataTransfer.effectAllowed='move';try{e.dataTransfer.setData('text/plain',dragK);}catch(_){}});
  const clr=()=>grid.querySelectorAll('.srIb,.srIa,.srD').forEach(x=>x.classList.remove('srIb','srIa','srD'));
  grid.addEventListener('dragend',clr);
  grid.addEventListener('dragover',e=>{const d=e.target.closest('.srC');if(!d||!dragK)return;e.preventDefault();const r=d.getBoundingClientRect(),after=e.clientX>r.left+r.width/2;
    grid.querySelectorAll('.srIb,.srIa').forEach(x=>x.classList.remove('srIb','srIa'));if(d.dataset.k!==dragK)d.classList.add(after?'srIa':'srIb');});
  grid.addEventListener('drop',e=>{e.preventDefault();const d=e.target.closest('.srC');if(!d||!dragK||d.dataset.k===dragK){clr();dragK=null;return;}
    const r=d.getBoundingClientRect(),after=e.clientX>r.left+r.width/2,o=st.order;o.splice(o.indexOf(dragK),1);let to=o.indexOf(d.dataset.k)+(after?1:0);o.splice(to,0,dragK);dragK=null;commit();});
  function show(){if(SR.open)return;SR.open=true;curEl=slides[cur];frame=null;el$.classList.add('open');render();
    // painting thumbnails animates other slides off screen; the current one is replayed on close
  }
  function close(to){SR.open=false;el$.classList.remove('open');document.querySelectorAll('.slide.on').forEach(x=>x.classList.remove('on'));
    let i=to!=null?to:slides.indexOf(curEl);if(i<0)i=Math.min(cur,slides.length-1);cur=Math.min(cur,slides.length-1);go(i);}
  function download(){const doc=new DOMParser().parseFromString(PRISTINE,'text/html'),dk=doc.getElementById('deck'),secs={};
    const cm={};dk.querySelectorAll(':scope>section.slide').forEach(x=>{secs[x.dataset.fx]=x;let p=x.previousSibling;while(p&&p.nodeType===3&&!p.textContent.trim())p=p.previousSibling;if(p&&p.nodeType===8)cm[x.dataset.fx]=p;});
    const anchor=doc.createComment(' end of slides ');dk.insertBefore(anchor,dk.querySelector(':scope>section.slide'));
    Object.keys(secs).forEach(k=>{secs[k].remove();if(cm[k])cm[k].remove();});
    [...dk.childNodes].forEach(n=>{if(n.nodeType===3&&!n.textContent.trim())n.remove();});
    st.order.forEach(k=>{const x=secs[k];if(!x)return;if(st.hidden.includes(k))x.setAttribute('data-hidden','1');else x.removeAttribute('data-hidden');
      dk.insertBefore(doc.createTextNode('\n'),anchor);if(cm[k]){dk.insertBefore(cm[k],anchor);dk.insertBefore(doc.createTextNode('\n'),anchor);}dk.insertBefore(x,anchor);dk.insertBefore(doc.createTextNode('\n'),anchor);});
    anchor.remove();
    const html='<!doctype html>\n'+doc.documentElement.outerHTML,a=document.createElement('a');a.href=URL.createObjectURL(new Blob([html],{type:'text/html'}));
    a.download=location.pathname.split('/').pop()||'deck.html';document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1000);}
  $('srDone').onclick=()=>close();$('srSave').onclick=download;
  $('srReset').onclick=()=>{st={order:ALL.map(fx),hidden:[]};commit();};
  addEventListener('keydown',e=>{if(!SR.open)return;if(e.key==='Escape'||e.key==='g'||e.key==='G'){e.preventDefault();close();}});
  return {open:false,show};})();
if(new URLSearchParams(location.search).has('walk')){for(let w=0;w<slides.length;w++){go(w);if(frame)for(let k=0;k<12;k+=1/10)frame(k);}
  const ids={};document.querySelectorAll('[id]').forEach(e=>ids[e.id]=(ids[e.id]||0)+1);const d=Object.keys(ids).filter(k=>ids[k]>1);document.title='DUPES:'+d.join(',');}
go(TGT);
})();

</script>
</body>
</html>
