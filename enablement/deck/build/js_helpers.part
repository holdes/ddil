<script>
(function(){
const PRISTINE='<!doctype html>\n'+document.documentElement.outerHTML;
const MARK='<svg viewBox="0 0 236.6 235.6" xmlns="http://www.w3.org/2000/svg"><path d="M236.6 123.5a46.54 46.54 0 0 0-30.8-43.9A67 67 0 0 0 140.2 0 66.72 66.72 0 0 0 86 27.7a35.5 35.5 0 0 0-57.2 28.1A36.77 36.77 0 0 0 31 68.2a46.75 46.75 0 0 0-.1 88 66.66 66.66 0 0 0 119.6 51.6 35 35 0 0 0 21.7 7.6 35.51 35.51 0 0 0 35.5-35.5 36.77 36.77 0 0 0-2.2-12.4 47.08 47.08 0 0 0 31.1-44" fill="#fff"/><path d="M93 101.5l51.8 23.6L197 79.3a54.71 54.71 0 0 0 1.1-11.5 58.35 58.35 0 0 0-106.5-33l-8.7 45.1L93 101.5z" fill="#fed10a"/><path d="M39.4 156.3a56.62 56.62 0 0 0-1.1 11.7 58.58 58.58 0 0 0 107 32.9l8.6-44.9-11.5-22-52-23.7z" fill="#24bbb1"/><path d="M39.1 66.7l35.5 8.4 7.8-40.3a28 28 0 0 0-43.3 31.9" fill="#ef5098"/><path d="M36 75.2a39.1 39.1 0 0 0-1.7 73.7l49.8-45L75 84.4z" fill="#17a8e0"/><path d="M154.3 200.9a28 28 0 0 0 43.2-31.9l-35.4-8.3z" fill="#93c83e"/><path d="M161.5 151.4l39 9.1a39.1 39.1 0 0 0 1.7-73.7l-51 44.7z" fill="#0779a1"/></svg>';
const ease=t=>t<=0?0:t>=1?1:1-Math.pow(1-t,3);
const io=t=>t<=0?0:t>=1?1:t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
const rand=s=>()=>(s=(s*16807)%2147483647)/2147483647;
const NS='http://www.w3.org/2000/svg',$=id=>document.getElementById(id),on=(id,v)=>$(id).classList.toggle('on',v);
const C={blue:'#0B64DD',pink:'#F04E98',teal:'#02BCB7',orange:'#FF7E62',ink:'#1D1E24',grey:'#69707D',gl:'#98A2B3',line:'#D3DAE6',sl:'#C5CCD8'};
const slides=[...document.querySelectorAll('.slide')],deck=$('deck');
slides.forEach(s=>{const f=document.createElement('div');f.className='foot';f.innerHTML=`<span class="lg">${MARK}elastic</span><span>${s.dataset.foot||''}</span>`;s.appendChild(f);});
function cv(slide,x,y,w,h){const c=document.createElement('canvas');c.className='fx';Object.assign(c.style,{left:x+'px',top:y+'px',width:w+'px',height:h+'px'});c.width=w*2;c.height=h*2;slide.appendChild(c);const g=c.getContext('2d');g.scale(2,2);return g;}
function prep(c,w,h){c.width=w*2;c.height=h*2;const g=c.getContext('2d');g.setTransform(2,0,0,2,0,0);return g;}
function el(p,n,a,t){const e=document.createElementNS(NS,n);for(const k in a)e.setAttribute(k,a[k]);if(t!=null)e.textContent=t;p.appendChild(e);return e;}

const FX={};
const mono=(g,w,z)=>g.font=`${w} ${z}px 'IBM Plex Mono', monospace`;

