# Copy to .env and fill in real values before `docker compose up`.
# .env is gitignored — never commit real credentials (this repo is PUBLIC).

# Superuser / bootstrap password for the ddil-vineyard ES cluster.
ELASTIC_PASSWORD=change-me

# kibana_system service-account password (Kibana -> ES).
KIBANA_SYSTEM_PASSWORD=change-me

# Kibana saved-objects/security/reporting encryption key (>=32 chars, stable).
KIBANA_ENCRYPTION_KEY=change-me-to-a-32char-min-random-key
